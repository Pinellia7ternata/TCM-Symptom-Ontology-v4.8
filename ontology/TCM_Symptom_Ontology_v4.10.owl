    <tcm:triggerText>情绪紧张</tcm:triggerText>
    <tcm:reliefText>体位调整</tcm:reliefText>
    <tcm:hpoID>HP:0003419</tcm:hpoID>
    <tcm:snomedCT>279039007</tcm:snomedCT>
    <tcm:snomedCTTerm>low back pain</tcm:snomedCTTerm>
  
