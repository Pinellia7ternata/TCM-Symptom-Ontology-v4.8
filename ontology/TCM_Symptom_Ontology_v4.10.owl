    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>The tongue pale white, withered and dry with scant fluid, or even completely devoid of moisture on its surface. Seen in yang deficiency pattern.</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/tcm_v38/f#sx_耳内长息肉">
