    <tcm:icd11>SF90</tcm:icd11>
    <tcm:icd11Term>Kidney qi deficiency pattern (TM1)</tcm:icd11Term>
    <tcm:icd11>SE90</tcm:icd11>
    <tcm:icd11Term>Qi deficiency pattern (TM1)</tcm:icd11Term>
  
    <oboInOwl:id>TCM-SO:sx_肩耸</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>Elevation of both shoulders. Seen in lung qi deficiency pattern, or lung-kidney qi deficiency pattern.</obo:IAO_0000115>
    <oboInOwl:hasDbXref>ICD11:SF80</oboInOwl:hasDbXref>
    <oboInOwl:hasDbXref>ICD11:SF90</oboInOwl:hasDbXref>
    <oboInOwl:hasDbXref>ICD11:SE90</oboInOwl:hasDbXref>
  </owl:Class>
