    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_睡眠类"/>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#PsychiatricFinding"/>
    <tcm:definition xml:lang="zh-cn">舌生恶肉，初如豆大，逐渐头大蒂小，似菜花，表皮溃烂，流涎恶臭，剧痛碍食，因其形似蕈，故名舌菌。见于心脾毒火。</tcm:definition>
    <tcm:definition xml:lang="en">A malignant growth on the tongue—initially bean-sized, gradually developing a large head with a small stalk like a cauliflower, with ulcerated surface, foul drooling, and severe pain interfering with eating; named 'tongue mushroom' (shejun) for its mushroom-like appearance. Seen in heart-spleen toxic fire.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.2.1.49</tcm:reference>
    <tcm:severityText>中度至重度</tcm:severityText>
    <tcm:frequencyText>偶尔发作</tcm:frequencyText>
    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>药物治疗</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_舌菌</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>A malignant growth on the tongue—initially bean-sized, gradually developing a large head with a small stalk like a cauliflower, with ulcerated surface, foul drooling, and severe pain interfering with eating; named 'tongue mushroom' (shejun) for its mushroom-like appearance. Seen in heart-spleen toxic fire.</obo:IAO_0000115>
  
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/dueTo"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#FireEvil"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
