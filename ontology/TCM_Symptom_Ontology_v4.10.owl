        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/accompanies"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">咽喉部似有异物梗塞，咯之不出，咽之不下。见于肝气郁结证，或梅核气等。又称梅核气。</tcm:definition>
    <tcm:definition xml:lang="en">Throat with foreign objects not pharynx failure to descend. Seen in liver qi depression and binding pattern; plum-pit qi (globus pharyngis). Also known as plum-pit qi (globus pharyngis). [未译片段:似梗塞咯出]</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.1.6.2.9</tcm:reference>
    <tcm:synonym>梅核气</tcm:synonym>
    <tcm:severityText>中度</tcm:severityText>
    <tcm:frequencyText>持续性</tcm:frequencyText>
    <tcm:triggerText>环境刺激</tcm:triggerText>
    <tcm:reliefText>情绪调节</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_咽中如有梅核</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>Throat with foreign objects not pharynx failure to descend. Seen in liver qi depression and binding pattern; plum-pit qi (globus pharyngis). Also known as plum-pit qi (globus pharyngis). [未译片段:似梗塞咯出]</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>梅核气</oboInOwl:hasExactSynonym>
  
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/dueTo"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#EmotionE"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
