        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#EmotionRel"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N413851b294c042d29eaf2c602316efd9">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/accompanies"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">妇女在围绝经期伴随出现的以抑郁为主要表现的一系列症状，如月经紊乱、眩晕耳鸣、潮热汗出、烦躁易怒，或面目浮肿，或尿频失禁等。见于肾气亏虚、肾阴亏虚、肾阳亏虚、肾阴阳两虚证。</tcm:definition>
    <tcm:definition xml:lang="en">A cluster of symptoms dominated by depression occurring in women during the perimenopausal period, such as menstrual irregularity, dizziness and tinnitus, tidal fever with sweating, irritability, facial puffiness, or frequent/incontinent urination. Seen in kidney qi deficiency, kidney yin deficiency, kidney yang deficiency, or kidney yin-yang dual deficiency pattern.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.5.2.2.38</tcm:reference>
    <tcm:severityText>重度</tcm:severityText>
    <tcm:frequencyText>偶尔发作</tcm:frequencyText>
    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>情绪调节</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_经断前后抑郁</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>A cluster of symptoms dominated by depression occurring in women during the perimenopausal period, such as menstrual irregularity, dizziness and tinnitus, tidal fever with sweating, irritability, facial puffiness, or frequent/incontinent urination. Seen in kidney qi deficiency, kidney yin deficiency, kidney yang deficiency, or kidney yin-yang dual deficiency pattern.</obo:IAO_0000115>
  </owl:Class>
