        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">是沉、实、大、弦、长五种脉象复合而成，脉位在深部，轻取中取均不应，形大体长，势微弦，力强，坚牢不移。见于寒瘕、气结、心腹疼痛、风痉等。</tcm:definition>
    <tcm:definition xml:lang="en">A composite of deep, excess, large, wiry and long pulse qualities: located deep, unresponsive to light and moderate pressure, large and long in shape, slightly wiry in force, strong and firmly fixed (firm/ prison pulse). Seen in cold aggregation, qi binding, cardiac-abdominal pain, or wind spasm.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.2.2.10</tcm:reference>
    <tcm:severityText>重度</tcm:severityText>
    <tcm:frequencyText>持续性</tcm:frequencyText>
    <tcm:triggerText>情绪波动</tcm:triggerText>
    <tcm:reliefText>情绪调节</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_脉牢</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>A composite of deep, excess, large, wiry and long pulse qualities: located deep, unresponsive to light and moderate pressure, large and long in shape, slightly wiry in force, strong and firmly fixed (firm/ prison pulse). Seen in cold aggregation, qi binding, cardiac-abdominal pain, or wind spasm.</obo:IAO_0000115>
  
    <rdfs:subClassOf>
