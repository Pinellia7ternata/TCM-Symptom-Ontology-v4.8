    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_睡眠类"/>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#PsychiatricFinding"/>
    <tcm:definition xml:lang="zh-cn">胃不任药物气味，服药即呕吐。见于使用药物过于峻烈或有消化道副反应，或个人体质。</tcm:definition>
    <tcm:definition xml:lang="en">The stomach cannot tolerate the smell or taste of medicine, and vomiting occurs immediately after taking it. Seen with overly drastic medication or gastrointestinal side effects, or due to individual constitution.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.1.3.44</tcm:reference>
    <tcm:severityText>轻度</tcm:severityText>
    <tcm:frequencyText>偶尔发作</tcm:frequencyText>
    <tcm:triggerText>药物副作用</tcm:triggerText>
    <tcm:reliefText>药物治疗</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_纳药呕吐</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>The stomach cannot tolerate the smell or taste of medicine, and vomiting occurs immediately after taking it. Seen with overly drastic medication or gastrointestinal side effects, or due to individual constitution.</obo:IAO_0000115>
  </owl:Class>
