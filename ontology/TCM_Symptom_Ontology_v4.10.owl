  <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/tcm_v38/f#sx_患病半身发胀">
    <rdfs:label xml:lang="zh-cn">患病半身发胀</rdfs:label>
    <rdfs:label xml:lang="en">distension of the affected hemibody</rdfs:label>
