    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#PsychiatricFinding"/>
    <tcm:definition xml:lang="zh-cn">在薄白苔上两旁各呈一条黄苔。见于热入少阳证、胃肠热盛证等。</tcm:definition>
    <tcm:definition xml:lang="en">A yellow stripe of coating on each side of a thin white tongue coating. Seen in heat entering the shaoyang pattern, or gastrointestinal exuberant heat pattern.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.2.1.87</tcm:reference>
    <tcm:severityText>轻度</tcm:severityText>
    <tcm:frequencyText>每日多次</tcm:frequencyText>
    <tcm:triggerText>情绪波动</tcm:triggerText>
    <tcm:reliefText>情绪调节</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_双黄苔</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>A yellow stripe of coating on each side of a thin white tongue coating. Seen in heat entering the shaoyang pattern, or gastrointestinal exuberant heat pattern.</obo:IAO_0000115>
  
    <rdfs:subClassOf>
