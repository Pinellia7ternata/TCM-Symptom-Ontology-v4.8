        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/dueTo"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#WindEvil"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
