    <tcm:reliefText>药物治疗</tcm:reliefText>
    <tcm:hpoID>HP:0025309</tcm:hpoID>
    <tcm:icd11>LA11.60</tcm:icd11>
    <tcm:icd11Term>Irregular pupil of the eye</tcm:icd11Term>
  
