        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/q#Present"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nb4259732b2584b63b971707d4a9186c1">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/aggravatedBy"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#EmotionAgg"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N157aaa0a705c47918422f2140f1d1815">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/relievedBy"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#EmotionRel"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nf683638d52ce4a1b952e0e167711a144">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/accompanies"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">外耳道内长有良性肿物，伴有耳堵塞感、耳鸣、耳痒或听力减退。见于慢脓耳、耳疮、异物长期留存等慢性疾病。又称耳痔、耳挺等。</tcm:definition>
    <tcm:definition xml:lang="en">External ear canal inside growing benign mass accompanied by ear blocking sensation tinnitus ear itching or decreased hearing. Seen in chronic suppurative otitis media; ear sore (otitis externa). [证候待译:异物长期留存等慢性疾病] Also known as ear polyp, ear polyp.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.6.10.2.9</tcm:reference>
    <tcm:synonym>耳挺</tcm:synonym>
    <tcm:synonym>耳痔</tcm:synonym>
    <tcm:severityText>轻度至中度</tcm:severityText>
    <tcm:frequencyText>间歇性</tcm:frequencyText>
    <tcm:triggerText>环境刺激</tcm:triggerText>
    <tcm:reliefText>情绪调节</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_耳内长息肉</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>External ear canal inside growing benign mass accompanied by ear blocking sensation tinnitus ear itching or decreased hearing. Seen in chronic suppurative otitis media; ear sore (otitis externa). [证候待译:异物长期留存等慢性疾病] Also known as ear polyp, ear polyp.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>耳挺</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym>耳痔</oboInOwl:hasExactSynonym>
  </owl:Class>
