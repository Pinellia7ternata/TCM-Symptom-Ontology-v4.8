    <tcm:snomedCTTerm>abnormal pinnae</tcm:snomedCTTerm>
    <tcm:snomedCT>19416009</tcm:snomedCT>
    <tcm:snomedCTTerm>abnormal eye</tcm:snomedCTTerm>
  
