  <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/tcm_v38/f#sx_五心烦热">
    <rdfs:label xml:lang="zh-cn">五心烦热</rdfs:label>
    <rdfs:label xml:lang="en">heat in the five centers (palms, soles and chest)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_发热类"/>
