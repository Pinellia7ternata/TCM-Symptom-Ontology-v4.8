    <rdfs:label xml:lang="zh-cn">心烦</rdfs:label>
    <rdfs:label xml:lang="en">vexation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_精神情志类"/>
