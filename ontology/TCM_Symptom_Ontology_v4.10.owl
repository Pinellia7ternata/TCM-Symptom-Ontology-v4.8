    <tcm:definition xml:lang="zh-cn">自觉手足四肢寒冷。见于经脉气血循行不或阳虚证。</tcm:definition>
    <tcm:definition xml:lang="en">Subjective coldness of the hands, feet and limbs. Seen in impaired circulation of qi and blood in the channels, or yang deficiency pattern.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.1.1.1.1</tcm:reference>
    <tcm:synonym>肢冷</tcm:synonym>
    <tcm:severityText>中度至重度</tcm:severityText>
    <tcm:frequencyText>持续性</tcm:frequencyText>
    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>休息、保暖</tcm:reliefText>
    <tcm:hpoID>HP:6000500</tcm:hpoID>
  
    <oboInOwl:id>TCM-SO:sx_四肢冷</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>Subjective coldness of the hands, feet and limbs. Seen in impaired circulation of qi and blood in the channels, or yang deficiency pattern.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>肢冷</oboInOwl:hasExactSynonym>
    <oboInOwl:hasDbXref>HPO:HP:6000500</oboInOwl:hasDbXref>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/HP_6000500"/>
