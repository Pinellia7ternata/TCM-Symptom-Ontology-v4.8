        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#EnvironmentAgg"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Na34e2be866af4b4ca3b3e0ea776771c2">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/relievedBy"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#DietRel"/>
      </owl:Restriction>
    </rdfs:subClassOf>
