    <tcm:reliefText>休息、保暖</tcm:reliefText>
    <tcm:snomedCT>2472002</tcm:snomedCT>
    <tcm:snomedCTTerm>absent urine output</tcm:snomedCTTerm>
    <tcm:icd11>MF51</tcm:icd11>
    <tcm:icd11Term>Anuria or oliguria</tcm:icd11Term>
  
    <oboInOwl:id>TCM-SO:sx_无尿</oboInOwl:id>
