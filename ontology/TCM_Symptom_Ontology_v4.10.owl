        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/relievedBy"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#MedicationRel"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N90557bf65e294301bbfa83aad6e00093">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/accompanies"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">脉体较长，超过本部，可上至鱼际，下至尺后，其特点是长直。见于肝病、气逆、火盛、痰浊阻滞证，或癫痫、疝气等。向前逾寸部至鱼际，称为溢，向后逾尺部，称为覆。</tcm:definition>
    <tcm:definition xml:lang="en">A pulse whose length exceeds its normal position—reaching up toward the thenar eminence and down beyond the chi position—characteristically long and straight. Seen in liver disease, qi counterflow, fire exuberance, phlegm-turbidity obstruction pattern, or epilepsy and hernia disorder. Extension beyond the cun position toward the thenar is called overflow (yi); extension beyond the chi position is called covering (fu).</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.2.2.1</tcm:reference>
    <tcm:severityText>中度至重度</tcm:severityText>
    <tcm:frequencyText>间歇性</tcm:frequencyText>
    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>药物治疗</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_脉长</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>A pulse whose length exceeds its normal position—reaching up toward the thenar eminence and down beyond the chi position—characteristically long and straight. Seen in liver disease, qi counterflow, fire exuberance, phlegm-turbidity obstruction pattern, or epilepsy and hernia disorder. Extension beyond the cun position toward the thenar is called overflow (yi); extension beyond the chi position is called covering (fu).</obo:IAO_0000115>
  
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/dueTo"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#FireEvil"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/dueTo"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#PhlegmEvil"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
