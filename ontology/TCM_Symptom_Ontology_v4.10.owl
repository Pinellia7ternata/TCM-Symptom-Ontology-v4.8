    <tcm:frequencyText>偶尔发作</tcm:frequencyText>
    <tcm:triggerText>受凉、劳累</tcm:triggerText>
    <tcm:reliefText>饮食调整</tcm:reliefText>
    <tcm:icd11>SE90</tcm:icd11>
    <tcm:icd11Term>Qi deficiency pattern (TM1)</tcm:icd11Term>
    <tcm:icd11>SE93</tcm:icd11>
    <tcm:icd11Term>Qi sinking pattern (TM1)</tcm:icd11Term>
  
