        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_睡眠类"/>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#PsychiatricFinding"/>
    <tcm:definition xml:lang="zh-cn">口中津液不足，自觉干燥，或欲饮水，或不欲饮水。见于阴虚火旺证、水饮内停证、肝经火旺证、阴虚内热证、气阴亏虚证、肾阴亏虚证、肾阳亏虚证、瘀血内郁证等。又称口燥。</tcm:definition>
    <tcm:definition xml:lang="en">Insufficient fluid in the mouth with subjective dryness, with or without desire to drink. Seen in yin deficiency with effulgent fire pattern, water-rheum internal stagnation pattern, liver channel fire exuberance pattern, yin deficiency with internal heat pattern, qi-yin deficiency pattern, kidney yin deficiency pattern, kidney yang deficiency pattern, or static blood internal stagnation pattern. Also known as dry mouth (kouzao).</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.1.3.6</tcm:reference>
    <tcm:synonym>口干舌燥</tcm:synonym>
    <tcm:synonym>口燥</tcm:synonym>
    <tcm:hpoID>HP:0000217</tcm:hpoID>
    <tcm:severityText>重度</tcm:severityText>
    <tcm:frequencyText>间歇性</tcm:frequencyText>
    <tcm:triggerText>情绪波动</tcm:triggerText>
    <tcm:reliefText>药物治疗</tcm:reliefText>
    <tcm:snomedCT>249416005</tcm:snomedCT>
    <tcm:snomedCTTerm>Xerostomia</tcm:snomedCTTerm>
    <tcm:icd11>DA02.1</tcm:icd11>
    <tcm:icd11Term>Xerostomia</tcm:icd11Term>
  
    <oboInOwl:id>TCM-SO:sx_口干</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>Insufficient fluid in the mouth with subjective dryness, with or without desire to drink. Seen in yin deficiency with effulgent fire pattern, water-rheum internal stagnation pattern, liver channel fire exuberance pattern, yin deficiency with internal heat pattern, qi-yin deficiency pattern, kidney yin deficiency pattern, kidney yang deficiency pattern, or static blood internal stagnation pattern. Also known as dry mouth (kouzao).</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>口干舌燥</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym>口燥</oboInOwl:hasExactSynonym>
    <oboInOwl:hasDbXref>HPO:HP:0000217</oboInOwl:hasDbXref>
