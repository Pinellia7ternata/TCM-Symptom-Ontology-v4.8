        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/accompanies"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">心中郁闷不舒，或胸部憋闷不适，每以嘘气为快，或遇事悲观。见于肝气郁结证等。又称喜太息、善太息。</tcm:definition>
    <tcm:definition xml:lang="en">Oppressive discomfort in the chest relieved by sighing, or a pessimistic outlook on events. Seen in liver qi depression pattern. Also known as fondness for sighing and frequent sighing.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.1.4.1.4</tcm:reference>
    <tcm:synonym>善太息</tcm:synonym>
    <tcm:synonym>喜叹息</tcm:synonym>
    <tcm:synonym>喜善太息</tcm:synonym>
    <tcm:synonym>喜太息</tcm:synonym>
    <tcm:synonym>喜长叹息</tcm:synonym>
