      <owl:Restriction rdf:nodeID="Nb6453468bdd3441fa3329ca0578c3e46">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/accompanies"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">黑睛深层呈现一片灰白色翳障，混浊不清，漫掩黑睛。见于混睛障、风轮风热证、风轮湿热证、风轮阴虚证、脾气虚证等。</tcm:definition>
    <tcm:definition xml:lang="en">A gray-white opacity in the deep layers of the cornea, turbid and unclear, spreading over the cornea (mixed-eye opacity/stromal keratitis). Seen in mixed-eye opacity, wind-wheel wind-heat pattern, wind-wheel dampness-heat pattern, wind-wheel yin deficiency pattern, or spleen qi deficiency pattern.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.6.10.1.38</tcm:reference>
    <tcm:severityText>轻度</tcm:severityText>
    <tcm:frequencyText>持续性</tcm:frequencyText>
    <tcm:triggerText>受凉、劳累</tcm:triggerText>
    <tcm:reliefText>休息、保暖</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_黑睛浑浊</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>A gray-white opacity in the deep layers of the cornea, turbid and unclear, spreading over the cornea (mixed-eye opacity/stromal keratitis). Seen in mixed-eye opacity, wind-wheel wind-heat pattern, wind-wheel dampness-heat pattern, wind-wheel yin deficiency pattern, or spleen qi deficiency pattern.</obo:IAO_0000115>
  
    <rdfs:subClassOf>
      <owl:Restriction>
