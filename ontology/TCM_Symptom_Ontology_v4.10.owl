    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_睡眠类"/>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#PsychiatricFinding"/>
    <tcm:definition xml:lang="zh-cn">小儿经常在夜间啼哭不停，甚至通宵达旦。见于脾阳虚证，或夜啼、昼夜节律未调等。</tcm:definition>
    <tcm:definition xml:lang="en">A small child crying incessantly, often at night, even through the whole night. Seen in spleen yang deficiency pattern, or night crying and unsettled day-night rhythm.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.3.1.31</tcm:reference>
    <tcm:severityText>中度至重度</tcm:severityText>
    <tcm:frequencyText>每日多次</tcm:frequencyText>
    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>药物治疗</tcm:reliefText>
    <tcm:icd11>SE36</tcm:icd11>
    <tcm:icd11Term>Night crying disorder (TM1)</tcm:icd11Term>
  
    <oboInOwl:id>TCM-SO:sx_小儿哭声延绵</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>A small child crying incessantly, often at night, even through the whole night. Seen in spleen yang deficiency pattern, or night crying and unsettled day-night rhythm.</obo:IAO_0000115>
    <oboInOwl:hasDbXref>ICD11:SE36</oboInOwl:hasDbXref>
  </owl:Class>
  <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/tcm_v38/f#sx_妊娠厌食">
    <rdfs:label xml:lang="zh-cn">妊娠厌食</rdfs:label>
    <rdfs:label xml:lang="en">anorexia during pregnancy</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_胎产类"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N6a1242e81e89401f8bf29151abb837a5">
