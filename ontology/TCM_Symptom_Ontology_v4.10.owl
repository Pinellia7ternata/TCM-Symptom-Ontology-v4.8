        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">皮肤渗液多或潮湿流滋不止。见于湿疮、湿疣等。</tcm:definition>
    <tcm:definition xml:lang="en">Skin oozing of fluid profuse or dampness/moisture oozing of serous fluid incessant. Seen in eczema. [证候待译:湿疣]</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.6.4.154</tcm:reference>
    <tcm:severityText>轻度至中度</tcm:severityText>
    <tcm:frequencyText>每日多次</tcm:frequencyText>
    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>休息、保暖</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_皮肤潮湿浸淫</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>Skin oozing of fluid profuse or dampness/moisture oozing of serous fluid incessant. Seen in eczema. [证候待译:湿疣]</obo:IAO_0000115>
  
