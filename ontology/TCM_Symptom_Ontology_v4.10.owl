    <tcm:frequencyText>数小时一次</tcm:frequencyText>
    <tcm:triggerText>寒冷刺激</tcm:triggerText>
    <tcm:reliefText>止痛药物</tcm:reliefText>
    <tcm:icd11>GA34.02</tcm:icd11>
    <tcm:icd11Term>Vulvodynia</tcm:icd11Term>
  
