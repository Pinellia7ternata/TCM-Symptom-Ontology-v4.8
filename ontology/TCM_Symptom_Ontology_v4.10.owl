    <tcm:reliefText>药物治疗</tcm:reliefText>
    <tcm:snomedCT>60332004</tcm:snomedCT>
    <tcm:snomedCTTerm>ingrown eyelashes</tcm:snomedCTTerm>
    <tcm:icd11>SK6E</tcm:icd11>
