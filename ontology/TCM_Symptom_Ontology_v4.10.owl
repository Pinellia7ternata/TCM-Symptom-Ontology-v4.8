  <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/tcm_v38/f#sx_带下清稀">
    <rdfs:label xml:lang="zh-cn">带下清稀</rdfs:label>
    <rdfs:label xml:lang="en">thin and clear vaginal discharge</rdfs:label>
