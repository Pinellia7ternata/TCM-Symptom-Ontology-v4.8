    <tcm:snomedCTTerm>alopecia areata</tcm:snomedCTTerm>
    <tcm:snomedCT>278040002</tcm:snomedCT>
    <tcm:snomedCTTerm>absence of scalp hair</tcm:snomedCTTerm>
    <tcm:snomedCT>56317004</tcm:snomedCT>
