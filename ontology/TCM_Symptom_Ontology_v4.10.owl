  <owl:Ontology rdf:about="http://OntoTCM.org.cn/ontologies/tcm_v38/ontology">
    <owl:versionIRI rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v410/4.10.0"/>
    <dc:title>TCM Symptom Ontology</dc:title>
    <dc:description>A large-scale bilingual (Chinese-English) OWL 2 ontology of Traditional Chinese Medicine symptoms: 1,758 symptom classes in 31 clinical categories with HPO-style English definitions, a formally axiomatized clinical-semantic layer, and expert-confirmed alignments to HPO, SNOMED CT and ICD-11.</dc:description>
    <dc:creator>Chao Chen; Zehui Chen; Zheji Han; Lei Lei</dc:creator>
    <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
    <oboInOwl:default-namespace>TCM-SO</oboInOwl:default-namespace>
    <obo:IAO_0000700 rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/ClinicalFinding"/>
    <owl:versionInfo>4.10.0 (2026-09-17)</owl:versionInfo>
    <rdfs:label xml:lang="en">TCM Symptom Ontology v4.10</rdfs:label>
    <rdfs:label xml:lang="zh-cn">中医症状本体 v4.10 — 复合症状等价公理试点</rdfs:label>
  </owl:Ontology>
