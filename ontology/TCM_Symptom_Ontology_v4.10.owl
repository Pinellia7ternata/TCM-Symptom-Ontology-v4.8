        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#EmotionE"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/dueTo"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#FireEvil"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
