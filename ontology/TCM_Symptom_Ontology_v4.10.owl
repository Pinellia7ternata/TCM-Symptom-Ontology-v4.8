    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>饮食调整</tcm:reliefText>
    <tcm:snomedCT>90216006</tcm:snomedCT>
    <tcm:snomedCTTerm>eyelid adhesion to globe of eye</tcm:snomedCTTerm>
  
