    <tcm:definition xml:lang="zh-cn">鼻孔干燥致极色黑，边缘如染烟尘。见于阳毒热深。</tcm:definition>
    <tcm:definition xml:lang="en">The nostrils extremely dry, black as soot, with edges as if stained by smoke dust. Seen in deep-seated yang toxin heat.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.6.10.3.28</tcm:reference>
    <tcm:severityText>轻度至中度</tcm:severityText>
    <tcm:frequencyText>偶尔发作</tcm:frequencyText>
    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>休息、保暖</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_鼻孔干燥_黑如烟煤</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>The nostrils extremely dry, black as soot, with edges as if stained by smoke dust. Seen in deep-seated yang toxin heat.</obo:IAO_0000115>
  
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/dueTo"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#FireEvil"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
