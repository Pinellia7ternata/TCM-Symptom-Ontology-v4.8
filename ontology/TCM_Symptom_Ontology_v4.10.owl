    <tcm:frequencyText>间歇性</tcm:frequencyText>
    <tcm:triggerText>饮食不当</tcm:triggerText>
    <tcm:reliefText>休息、保暖</tcm:reliefText>
    <tcm:icd11>SF7M</tcm:icd11>
    <tcm:icd11Term>Spleen and kidney yang deficiency pattern (TM1)</tcm:icd11Term>
    <tcm:icd11>SF97</tcm:icd11>
    <tcm:icd11Term>Kidney yang deficiency pattern (TM1)</tcm:icd11Term>
  
