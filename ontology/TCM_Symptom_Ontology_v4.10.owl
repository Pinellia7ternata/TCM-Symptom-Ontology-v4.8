    <tcm:icd11Term>Patchy alopecia disorder (TM2)</tcm:icd11Term>
  
    <oboInOwl:id>TCM-SO:sx_脱发</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
