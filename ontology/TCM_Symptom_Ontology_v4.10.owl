    <tcm:frequencyText>偶尔发作</tcm:frequencyText>
    <tcm:triggerText>劳累、姿势不当</tcm:triggerText>
    <tcm:reliefText>止痛药物</tcm:reliefText>
    <tcm:snomedCT>102556003</tcm:snomedCT>
