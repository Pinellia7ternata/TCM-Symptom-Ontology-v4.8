    <tcm:reliefText>情绪调节</tcm:reliefText>
    <tcm:hpoID>HP:0000952</tcm:hpoID>
    <tcm:snomedCT>18165001</tcm:snomedCT>
    <tcm:snomedCTTerm>icterus</tcm:snomedCTTerm>
  
