    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#PsychiatricFinding"/>
    <tcm:definition xml:lang="zh-cn">咳唾痰，闻之有腥秽气。见于虚寒证、脾肾阳虚证，或哮喘后期等。</tcm:definition>
    <tcm:definition xml:lang="en">Coughed or spat phlegm with a fishy, foul smell. Seen in deficiency cold pattern, spleen-kidney yang deficiency pattern, or late-stage asthma.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.3.2.5</tcm:reference>
    <tcm:severityText>中度至重度</tcm:severityText>
    <tcm:frequencyText>偶尔发作</tcm:frequencyText>
    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>饮食调整</tcm:reliefText>
    <tcm:icd11>SF7M</tcm:icd11>
    <tcm:icd11Term>Spleen and kidney yang deficiency pattern (TM1)</tcm:icd11Term>
  
    <oboInOwl:id>TCM-SO:sx_痰腥</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>Coughed or spat phlegm with a fishy, foul smell. Seen in deficiency cold pattern, spleen-kidney yang deficiency pattern, or late-stage asthma.</obo:IAO_0000115>
    <oboInOwl:hasDbXref>ICD11:SF7M</oboInOwl:hasDbXref>
  
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/dueTo"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#ColdEvil"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
