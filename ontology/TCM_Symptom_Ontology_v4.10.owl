        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/accompanies"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">指大指节后肌肉丰隆处的脉络色青。见于胃中寒。</tcm:definition>
    <tcm:definition xml:lang="en">Bluish-green venules over the thenar eminence (the muscular prominence after the thumb knuckle). Seen in stomach cold.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.2.3.2</tcm:reference>
    <tcm:severityText>轻度至中度</tcm:severityText>
    <tcm:frequencyText>每日多次</tcm:frequencyText>
    <tcm:triggerText>环境刺激</tcm:triggerText>
    <tcm:reliefText>药物治疗</tcm:reliefText>
    <tcm:hpoID>HP:0001245</tcm:hpoID>
    <tcm:icd11>XA57N0</tcm:icd11>
    <tcm:icd11Term>Malar eminence</tcm:icd11Term>
    <tcm:icd11>XA2JN4</tcm:icd11>
    <tcm:icd11Term>Thenar eminence</tcm:icd11Term>
  
    <oboInOwl:id>TCM-SO:sx_鱼际脉络青</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>Bluish-green venules over the thenar eminence (the muscular prominence after the thumb knuckle). Seen in stomach cold.</obo:IAO_0000115>
    <oboInOwl:hasDbXref>HPO:HP:0001245</oboInOwl:hasDbXref>
