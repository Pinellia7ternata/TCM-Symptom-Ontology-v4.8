    <tcm:triggerText>环境刺激</tcm:triggerText>
    <tcm:reliefText>药物治疗</tcm:reliefText>
    <tcm:icd11>SF55</tcm:icd11>
    <tcm:icd11Term>Liver depression and blood stasis pattern (TM1)</tcm:icd11Term>
  
