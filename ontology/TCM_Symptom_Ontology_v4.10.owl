        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/relievedBy"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#RestRel"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N2b9aa6d9917245118cb718dce43ea824">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/accompanies"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_睡眠类"/>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#PsychiatricFinding"/>
    <tcm:definition xml:lang="zh-cn">尿浊色白如泔浆者，较较乳糜清。见于肾阳虚衰证、脾虚气陷证，或膏淋、丝虫病、肾痨、精浊、肾系癌瘤。又称白浊。</tcm:definition>
    <tcm:definition xml:lang="en">Turbid white urine like rice-washing water, thinner than chyluria. Seen in kidney yang debilitation pattern, spleen deficiency with qi sinking pattern, or unctuous strangury (gaolin), filariasis, kidney consumption (renal tuberculosis), essence turbidity (prostatitis), or kidney-system carcinoma. Also known as white turbidity.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.4.1.22</tcm:reference>
    <tcm:synonym>白浊</tcm:synonym>
    <tcm:severityText>轻度</tcm:severityText>
    <tcm:frequencyText>每日多次</tcm:frequencyText>
    <tcm:triggerText>饮食不当</tcm:triggerText>
    <tcm:reliefText>休息、保暖</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_尿白</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>Turbid white urine like rice-washing water, thinner than chyluria. Seen in kidney yang debilitation pattern, spleen deficiency with qi sinking pattern, or unctuous strangury (gaolin), filariasis, kidney consumption (renal tuberculosis), essence turbidity (prostatitis), or kidney-system carcinoma. Also known as white turbidity.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>白浊</oboInOwl:hasExactSynonym>
  
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/dueTo"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#WormEvil"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
