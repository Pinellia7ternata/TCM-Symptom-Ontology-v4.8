        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">用指按压脓部，有脓但不欲流。见于脓未溃。</tcm:definition>
    <tcm:definition xml:lang="en">On finger pressure over the pus area, pus is present but does not flow out. Seen when the abscess has not yet ulcerated.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.6.1.28</tcm:reference>
    <tcm:severityText>重度</tcm:severityText>
    <tcm:frequencyText>间歇性</tcm:frequencyText>
    <tcm:triggerText>受凉、劳累</tcm:triggerText>
    <tcm:reliefText>情绪调节</tcm:reliefText>
    <tcm:icd11>XE94J</tcm:icd11>
    <tcm:icd11Term>No pressure</tcm:icd11Term>
  
    <oboInOwl:id>TCM-SO:sx_指按有脓不流</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>On finger pressure over the pus area, pus is present but does not flow out. Seen when the abscess has not yet ulcerated.</obo:IAO_0000115>
    <oboInOwl:hasDbXref>ICD11:XE94J</oboInOwl:hasDbXref>
  </owl:Class>
