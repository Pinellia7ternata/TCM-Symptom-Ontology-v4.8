    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_睡眠类"/>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#PsychiatricFinding"/>
    <tcm:definition xml:lang="zh-cn">咳嗽声音清脆，无痰或少痰。见于外感燥邪证、肺阴虚证、燥邪犯肺证、肝火犯肺证，或胁痛等。</tcm:definition>
    <tcm:definition xml:lang="en">A crisp-sounding cough with no sputum or scant sputum. Seen in externally contracted dryness pathogen pattern, lung yin deficiency pattern, dryness pathogen invading the lung pattern, liver fire invading the lung pattern, or hypochondriac pain.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.3.1.42</tcm:reference>
    <tcm:severityText>重度</tcm:severityText>
    <tcm:frequencyText>间歇性</tcm:frequencyText>
    <tcm:triggerText>寒冷、烟尘</tcm:triggerText>
    <tcm:reliefText>止咳药物、保暖</tcm:reliefText>
    <tcm:icd11>SF8D</tcm:icd11>
    <tcm:icd11Term>Dryness invading the lung pattern (TM1)</tcm:icd11Term>
    <tcm:icd11>SF5M</tcm:icd11>
    <tcm:icd11Term>Liver fire invading the lung system pattern (TM1)</tcm:icd11Term>
  
    <oboInOwl:id>TCM-SO:sx_干咳</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>A crisp-sounding cough with no sputum or scant sputum. Seen in externally contracted dryness pathogen pattern, lung yin deficiency pattern, dryness pathogen invading the lung pattern, liver fire invading the lung pattern, or hypochondriac pain.</obo:IAO_0000115>
    <oboInOwl:hasDbXref>ICD11:SF8D</oboInOwl:hasDbXref>
    <oboInOwl:hasDbXref>ICD11:SF5M</oboInOwl:hasDbXref>
  
