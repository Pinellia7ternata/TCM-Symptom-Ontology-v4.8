    <rdfs:label xml:lang="zh-cn">寒热往来，入暮尤剧</rdfs:label>
    <rdfs:label xml:lang="en">alternating chills and fever, worse at dusk</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_寒热间夹类"/>
    <rdfs:subClassOf>
