      <owl:Restriction rdf:nodeID="Na7278f6ce99744aa9c954f6a0a55d7bb">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/aggravatedBy"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#EmotionAgg"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nea021ec755bf4e6db595436d20f554db">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/relievedBy"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#RestRel"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N0931c8f00fa54c939e1a4f1323730c34">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/accompanies"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">脉来速率快，在搏动过程中时有间歇，但歇止没有一定的规律，止后复搏动。见于阳盛火亢、痰积、心气虚证、气滞证、血瘀证等。</tcm:definition>
    <tcm:definition xml:lang="en">A rapid pulse with intermittent pauses during beating; the pauses are irregular, after which beating resumes. Seen in yang exuberance with fire hyperactivity, phlegm accumulation, heart qi deficiency pattern, qi stagnation pattern, or blood stasis pattern.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.2.2.33</tcm:reference>
    <tcm:severityText>重度</tcm:severityText>
    <tcm:frequencyText>数小时一次</tcm:frequencyText>
    <tcm:triggerText>受凉、劳累</tcm:triggerText>
    <tcm:reliefText>休息、保暖</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_脉促</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>A rapid pulse with intermittent pauses during beating; the pauses are irregular, after which beating resumes. Seen in yang exuberance with fire hyperactivity, phlegm accumulation, heart qi deficiency pattern, qi stagnation pattern, or blood stasis pattern.</obo:IAO_0000115>
  
