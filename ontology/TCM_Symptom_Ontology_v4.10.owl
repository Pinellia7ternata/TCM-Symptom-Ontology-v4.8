    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>饮食调整</tcm:reliefText>
    <tcm:snomedCT>19829001</tcm:snomedCT>
    <tcm:snomedCTTerm>abnormal lung morphology</tcm:snomedCTTerm>
