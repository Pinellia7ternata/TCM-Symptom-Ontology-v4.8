        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#FireEvil"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/tcm_v38/f#sx_脉促">
    <rdfs:label xml:lang="zh-cn">脉促</rdfs:label>
    <rdfs:label xml:lang="en">Abrupt pulse</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_脉象"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nd5d5d38dfc4547c5b4dd9d6c460abba1">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/findingSite"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/bs#Pulse"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N05e8caaf4cff48b9a4b4ace02ff395e0">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/associatedMorphology"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/m#Petechiae"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N052417c1613b423c8e03739cfe23c1c3">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/dueTo"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#ColdEvil"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nd7af5e3ae1ba491d9a032837360e606c">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/hasSeverity"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/q#SevereQ"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nb950872ec7a8458a9b5fcdcf37eda15f">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/hasInterpretation"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/q#Present"/>
      </owl:Restriction>
    </rdfs:subClassOf>
