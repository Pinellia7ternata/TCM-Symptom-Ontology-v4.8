        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">不能看清晰或远或近的事物。见于肝肾亏虚证、元阳亏虚证，或偃月侵睛、花翳白陷、凝脂翳、黄液上冲、旋螺尖起、黑翳如珠、瞳睛病、正漏、混睛障、赤膜下垂、血翳包睛、宿翳等眼病。</tcm:definition>
    <tcm:definition xml:lang="en">Inability to see distant or near objects clearly. Seen in liver-kidney deficiency pattern, primal yang deficiency pattern, or eye diseases such as crescent-moon invading the eye (pterygium), flowery nebula with white sinking, congealed-fat nebula (suppurative keratitis), yellow fluid rushing upward (hypopyon), spiral bulge, black nebula like a pearl, pupil diseases, orthorrhea (fistula leakage), mixed-eye opacity, drooping red membrane (pannus), blood nebula enveloping the eye, or chronic nebula (corneal scar).</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.1.6.1.36</tcm:reference>
    <tcm:severityText>中度</tcm:severityText>
    <tcm:frequencyText>偶尔发作</tcm:frequencyText>
    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>饮食调整</tcm:reliefText>
    <tcm:hpoID>HP:0000622</tcm:hpoID>
    <tcm:hpoID>HP:0001125</tcm:hpoID>
    <tcm:snomedCT>111516008</tcm:snomedCT>
    <tcm:snomedCTTerm>blurred vision</tcm:snomedCTTerm>
    <tcm:snomedCT>246636008</tcm:snomedCT>
    <tcm:snomedCTTerm>blurred vision</tcm:snomedCTTerm>
  
