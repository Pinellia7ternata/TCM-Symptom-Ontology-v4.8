    <tcm:triggerText>情绪波动</tcm:triggerText>
    <tcm:reliefText>情绪调节</tcm:reliefText>
    <tcm:snomedCT>103276001</tcm:snomedCT>
    <tcm:snomedCTTerm>deafness</tcm:snomedCTTerm>
