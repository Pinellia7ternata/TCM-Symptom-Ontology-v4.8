    <tcm:frequencyText>间歇性</tcm:frequencyText>
    <tcm:triggerText>情绪波动</tcm:triggerText>
    <tcm:reliefText>饮食调整</tcm:reliefText>
    <tcm:icd11>MC14</tcm:icd11>
    <tcm:icd11Term>Eye discharge</tcm:icd11Term>
  
