      <owl:Restriction rdf:nodeID="Nac2f19bfbcfc4f9fa4c5be49a5c7f4bb">
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/accompanies"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#ClinicalFinding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <tcm:definition xml:lang="zh-cn">黑睛与黄仁（前房）之间出现黄色脓液，由下而冲上。见于脾胃湿热证、肝胆火炽证、阴虚胃热证等。</tcm:definition>
    <tcm:definition xml:lang="en">Yellow pus appearing between the cornea and the iris (in the anterior chamber), surging upward from below (hypopyon). Seen in spleen-stomach dampness-heat pattern, liver-gallbladder fire blazing pattern, and yin deficiency with stomach heat pattern.</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.6.10.1.31</tcm:reference>
    <tcm:severityText>轻度至中度</tcm:severityText>
    <tcm:frequencyText>数小时一次</tcm:frequencyText>
    <tcm:triggerText>饮食不当</tcm:triggerText>
    <tcm:reliefText>饮食调整</tcm:reliefText>
  
    <oboInOwl:id>TCM-SO:sx_黄液上冲</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>Yellow pus appearing between the cornea and the iris (in the anterior chamber), surging upward from below (hypopyon). Seen in spleen-stomach dampness-heat pattern, liver-gallbladder fire blazing pattern, and yin deficiency with stomach heat pattern.</obo:IAO_0000115>
  
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/dueTo"/>
        <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/e#DampnessEvil"/>
      </owl:Restriction>
    </rdfs:subClassOf>
