      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#cat_睡眠类"/>
    <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/tcm_v38/f#PsychiatricFinding"/>
    <tcm:definition xml:lang="zh-cn">咳嗽声时急时缓，咳声响亮而伴有回音，如犬吠叫。见于肺肾阴虚证、火毒攻喉证、阴虚燥热证、风热疫毒证、疫毒攻心证，或白喉等。</tcm:definition>
    <tcm:definition xml:lang="en">A loud, barking cough with echoing, alternating in urgency, like a dog's bark. Seen in lung-kidney yin deficiency pattern, fire toxin attacking the throat pattern, yin deficiency with dryness-heat pattern, wind-heat epidemic toxin pattern, epidemic toxin attacking the heart pattern, or diphtheria (baihou).</tcm:definition>
    <tcm:reference>Book(中医临床常见症状术语规范)、 8.3.1.63</tcm:reference>
    <tcm:severityText>重度</tcm:severityText>
    <tcm:frequencyText>数小时一次</tcm:frequencyText>
    <tcm:triggerText>感染、过敏</tcm:triggerText>
    <tcm:reliefText>避免刺激</tcm:reliefText>
    <tcm:hpoID>HP:0033121</tcm:hpoID>
    <tcm:icd11>MD12</tcm:icd11>
    <tcm:icd11Term>Cough</tcm:icd11Term>
  
    <oboInOwl:id>TCM-SO:sx_咳如犬吠</oboInOwl:id>
    <oboInOwl:hasOBONamespace>TCM_symptom</oboInOwl:hasOBONamespace>
    <obo:IAO_0000115>A loud, barking cough with echoing, alternating in urgency, like a dog's bark. Seen in lung-kidney yin deficiency pattern, fire toxin attacking the throat pattern, yin deficiency with dryness-heat pattern, wind-heat epidemic toxin pattern, epidemic toxin attacking the heart pattern, or diphtheria (baihou).</obo:IAO_0000115>
    <oboInOwl:hasDbXref>HPO:HP:0033121</oboInOwl:hasDbXref>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/HP_0033121"/>
