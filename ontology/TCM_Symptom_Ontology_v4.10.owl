    <tcm:snomedCT>14077003</tcm:snomedCT>
    <tcm:snomedCTTerm>pica</tcm:snomedCTTerm>
    <tcm:icd11>6B84</tcm:icd11>
    <tcm:icd11Term>Pica</tcm:icd11Term>
    <tcm:icd11>SF79</tcm:icd11>
